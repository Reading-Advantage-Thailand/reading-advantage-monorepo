  .notNull(),\n  },\n  (t) => [\n    index(\"audit_events_actor_idx\").on(t.actorUserId, t.createdAt),\n    index(\"audit_events_action_idx\").on(t.action, t.createdAt),\n    index(\"audit_events_target_idx\").on(t.targetType, t.targetId),\n  ]\n);","lineStart":1,"lineEnd":43,"totalLines":43,"truncated":false}},"title":"packages/db/src/schema/audit.ts","time":{"start":1780723455591,"end":1780723455612}},"id":"prt_e9b639183001UNVH5DCT2dCCcw","sessionID":"ses_1649db034ffe5PYzRZZZhfwsIg","messageID":"msg_e9b637fb9001X4KCUqgHgq3EtE"}}
