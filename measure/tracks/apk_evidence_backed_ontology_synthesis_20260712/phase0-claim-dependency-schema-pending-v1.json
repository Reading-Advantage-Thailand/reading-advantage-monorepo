{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reading-advantage:apk:t9:claim-dependency:v1",
  "title": "T9 claim dependency graph",
  "schema_version": "apk-t9-claim-dependency-schema.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream_claims",
    "derived_fields",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "apk-t9-claim-dependency-graph.v1"
    },
    "upstream_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "source_track",
          "accepted_manifest_sha256"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "source_track": {
            "type": "string",
            "minLength": 1
          },
          "accepted_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "derived_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "field_id"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upstream_claim_id",
          "derived_record_id",
          "derived_field_id"
        ],
        "properties": {
          "upstream_claim_id": {
            "type": "string",
            "minLength": 1
          },
          "derived_record_id": {
            "type": "string",
            "minLength": 1
          },
          "derived_field_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "semantic_rules": [
    "Every edge source resolves to exactly one accepted upstream claim.",
    "Every derived field has at least one incoming edge.",
    "The graph is acyclic and contains no derived-to-upstream back edge.",
    "Claim removal invalidates all directly and transitively dependent fields.",
    "A stale, revoked, missing, or non-consumable accepted-manifest binding invalidates every claim from that source."
  ]
}
