{
  "name": "@reading-advantage/codecamp-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph": "./dist/data/code-knowledge-space.json"
  },
  "files": ["dist", "source-snapshots"],
  "scripts": {
    "build": "tsc && node scripts/copy-data.mjs",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude src/__tests__/release-artifact.test.ts",
    "graph:validate": "pnpm build && node dist/cli.js validate",
    "graph:report": "pnpm build && node dist/cli.js report",
    "graph:verify-source": "pnpm build && node dist/cli.js verify-source",
    "bindings:validate": "pnpm build && node dist/cli.js bindings-validate",
    "bindings:report": "pnpm build && node dist/cli.js bindings-report",
    "bindings:verify-source": "pnpm build && node dist/cli.js bindings-verify-source",
    "bindings:generate": "tsx scripts/generate-curriculum-bindings.ts"
  },
  "dependencies": {
    "@reading-advantage/activity-runtime": "workspace:*",
    "@reading-advantage/activity-tutorial": "workspace:*",
    "@reading-advantage/knowledge-space-core": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "5.9.3",
    "tsx": "catalog:",
    "vitest": "4.1.8"
  }
}
