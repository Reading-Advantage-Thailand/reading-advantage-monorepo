{
  "name": "@reading-advantage/game-cartridges",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./host-proof": {
      "types": "./dist/host-proof.d.ts",
      "import": "./dist/host-proof.js",
      "default": "./dist/host-proof.js"
    },
    "./semantic-candidates": {
      "types": "./dist/existing-core-cutover-semantic-candidates.d.ts",
      "import": "./dist/existing-core-cutover-semantic-candidates.js",
      "default": "./dist/existing-core-cutover-semantic-candidates.js"
    },
    "./qc": {
      "types": "./dist/existing-core-cutover-qc.d.ts",
      "import": "./dist/existing-core-cutover-qc.js",
      "default": "./dist/existing-core-cutover-qc.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/catalog.ts src/host-proof.ts src/existing-core-cutover-semantic-candidates.ts src/existing-core-cutover-qc.ts --format esm && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@reading-advantage/advantage-play-kit": "workspace:*",
    "@reading-advantage/game-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
