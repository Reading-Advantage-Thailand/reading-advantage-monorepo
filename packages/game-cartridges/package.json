{
  "name": "@reading-advantage/game-cartridges",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./gate-runner": {
      "types": "./dist/gate-runner.d.ts",
      "import": "./dist/gate-runner.js",
      "default": "./dist/gate-runner.js"
    },
    "./sentence-collector": {
      "types": "./dist/sentence-collector.d.ts",
      "import": "./dist/sentence-collector.js",
      "default": "./dist/sentence-collector.js"
    },
    "./typing-defense": {
      "types": "./dist/typing-defense.d.ts",
      "import": "./dist/typing-defense.js",
      "default": "./dist/typing-defense.js"
    },
    "./editions": {
      "types": "./dist/editions.d.ts",
      "import": "./dist/editions.js",
      "default": "./dist/editions.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/catalog.ts src/gate-runner.ts src/sentence-collector.ts src/typing-defense.ts src/editions.ts --format esm --external phaser && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@reading-advantage/advantage-play-kit": "workspace:*",
    "@reading-advantage/game-contracts": "workspace:*",
    "phaser": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
