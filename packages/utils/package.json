{
  "name": "@reading-advantage/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    },
    "./ffmpeg-process": {
      "types": "./dist/ffmpeg-process.d.ts",
      "import": "./dist/ffmpeg-process.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cn.ts src/ffmpeg-process.ts src/hooks/index.ts --format esm --dts",
    "dev": "tsup src/index.ts src/cn.ts src/ffmpeg-process.ts src/hooks/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.2.2",
    "jsdom": "catalog:",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "react": "19.2.7"
  }
}
