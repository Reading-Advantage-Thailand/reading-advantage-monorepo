{
  "name": "@reading-advantage/auth-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "check-types:compat": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "check-types:rollback": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@reading-advantage/types": "workspace:*"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.2.2",
    "jsdom": "catalog:",
    "react": "19.2.7",
    "tsup": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "react": "19.2.7"
  }
}
