{
  "name": "@reading-advantage/mastery-runtime-compat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "runtime-manifest.json"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "check:consumer": "pnpm build && node dist/check-consumer.js",
    "check-types": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "check-types:compat": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "check-types:rollback": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --maxWorkers=1",
    "test:codecamp-proof": "vitest run src/__tests__/codecamp-proof.test.ts --maxWorkers=1",
    "test:packed-consumer": "vitest run src/__tests__/release-artifact.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@reading-advantage/domain": "workspace:*",
    "@reading-advantage/knowledge-space-core": "workspace:*",
    "@reading-advantage/knowledge-space-practice": "workspace:*",
    "@reading-advantage/practice-core": "workspace:*",
    "@reading-advantage/srs-engine": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
