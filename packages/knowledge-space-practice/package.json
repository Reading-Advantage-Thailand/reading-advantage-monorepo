{
  "name": "@reading-advantage/knowledge-space-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./misconception-loop": { "types": "./dist/misconception-loop.d.ts", "import": "./dist/misconception-loop.js" },
    "./blueprints": { "types": "./dist/blueprints/index.d.ts", "import": "./dist/blueprints/index.js" },
    "./planner/types": { "types": "./dist/planner/types.d.ts", "import": "./dist/planner/types.js" },
    "./planner/priority": { "types": "./dist/planner/priority.d.ts", "import": "./dist/planner/priority.js" },
    "./planner/unlock-value": { "types": "./dist/planner/unlock-value.d.ts", "import": "./dist/planner/unlock-value.js" },
    "./planner/recommended-next": { "types": "./dist/planner/recommended-next.d.ts", "import": "./dist/planner/recommended-next.js" },
    "./planner/domain-utility": { "types": "./dist/planner/domain-utility.d.ts", "import": "./dist/planner/domain-utility.js" },
    "./planner/review-load": { "types": "./dist/planner/review-load.d.ts", "import": "./dist/planner/review-load.js" },
    "./projections": { "types": "./dist/projections/index.d.ts", "import": "./dist/projections/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "check-types": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint src/",
    "test": "pnpm --filter @reading-advantage/knowledge-space-core build && pnpm --filter @reading-advantage/practice-core build && pnpm build && vitest run",
    "test:coverage": "pnpm --filter @reading-advantage/knowledge-space-core build && pnpm --filter @reading-advantage/practice-core build && pnpm build && vitest run --coverage"
  },
  "dependencies": {
    "@reading-advantage/knowledge-space-core": "workspace:*",
    "@reading-advantage/practice-core": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
