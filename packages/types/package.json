{
  "name": "@reading-advantage/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/class": {
      "types": "./dist/contracts/class.d.ts",
      "import": "./dist/contracts/class.js"
    },
    "./contracts/envelopes": {
      "types": "./dist/contracts/envelopes.d.ts",
      "import": "./dist/contracts/envelopes.js"
    },
    "./contracts/sales": {
      "types": "./dist/contracts/sales.d.ts",
      "import": "./dist/contracts/sales.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc",
    "lint": "eslint .",
    "check-types": "node ../../scripts/run-ts7-check-types.mjs --noEmit",
    "check-types:compat": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "check-types:rollback": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
