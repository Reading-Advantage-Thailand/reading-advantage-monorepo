{
  "name": "@reading-advantage/activity-tutorial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./contracts": { "types": "./dist/contracts.d.ts", "import": "./dist/contracts.js" },
    "./checker": { "types": "./dist/checker.d.ts", "import": "./dist/checker.js" },
    "./credentials": { "types": "./dist/credentials.d.ts", "import": "./dist/credentials.js" },
    "./credential-contracts": { "types": "./dist/credential-contracts.d.ts", "import": "./dist/credential-contracts.js" },
    "./report-contracts": { "types": "./dist/report-contracts.d.ts", "import": "./dist/report-contracts.js" },
    "./reporting": { "types": "./dist/reporting.d.ts", "import": "./dist/reporting.js" },
    "./offline": { "types": "./dist/offline.d.ts", "import": "./dist/offline.js" },
    "./scaffold": { "types": "./dist/scaffold.d.ts", "import": "./dist/scaffold.js" }
  },
  "bin": { "tutorial-check": "./dist/cli.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc",
    "check-types": "node ../../node_modules/typescript7/bin/tsc --noEmit -p tsconfig.test.json",
    "check-types:compat": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json",
    "check-types:rollback": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": { "typescript": "5.9.3", "zod": "catalog:" },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "4.1.8"
  }
}
