{
  "name": "@reading-advantage/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "import": "./dist/jobs/index.js"
    },
    "./finance-operations": {
      "types": "./dist/modules/finance-operations/index.d.ts",
      "import": "./dist/modules/finance-operations/index.js"
    },
    "./accounting": {
      "types": "./dist/modules/accounting/index.d.ts",
      "import": "./dist/modules/accounting/index.js"
    },
    "./company-identity/internal-route-adapter": {
      "types": "./dist/modules/company-identity/public-route-adapter.d.ts",
      "import": "./dist/modules/company-identity/public-route-adapter.js"
    },
    "./company-identity/accounts-route-adapter": {
      "types": "./dist/modules/company-identity/internal-route-adapter.d.ts",
      "import": "./dist/modules/company-identity/internal-route-adapter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@reading-advantage/db": "workspace:*",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@reading-advantage/advantage-play-kit": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
