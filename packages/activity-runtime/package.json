{
  "name": "@reading-advantage/activity-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./authoring": { "types": "./dist/authoring.d.ts", "import": "./dist/authoring.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./transport": { "types": "./dist/transport.d.ts", "import": "./dist/transport.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node ../../node_modules/typescript7/bin/tsc",
    "check-types": "node ../../node_modules/typescript7/bin/tsc --noEmit && node ../../node_modules/typescript7/bin/tsc --noEmit -p tsconfig.test.json",
    "check-types:compat": "node ../../node_modules/typescript/bin/tsc --noEmit && node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json",
    "check-types:rollback": "node ../../node_modules/typescript/bin/tsc --noEmit && node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/",
    "test": "pnpm build && vitest run --maxWorkers=1",
    "test:coverage": "pnpm build && vitest run --coverage --maxWorkers=1"
  },
  "dependencies": {
    "@reading-advantage/practice-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
