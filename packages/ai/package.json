{
  "name": "@reading-advantage/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal-sdk": {
      "types": "./dist/internal-sdk.d.ts",
      "import": "./dist/internal-sdk.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "check-types:compat": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "check-types:rollback": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/google-vertex": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
