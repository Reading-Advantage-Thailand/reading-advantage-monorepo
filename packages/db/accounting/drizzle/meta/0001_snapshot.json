      "checkConstraints": {
        "accounting_submissions_kind_check": {
          "name": "accounting_submissions_kind_check",
          "value": "\"accounting_submissions\".\"kind\" IN ('expense', 'bill')"
        },
        "accounting_submissions_payee_check": {
          "name": "accounting_submissions_payee_check",
          "value": "char_length(\"accounting_submissions\".\"payee\") between 1 and 256 AND \"accounting_submissions\".\"payee\" ~ '[^[:space:]]'"
        },
        "accounting_submissions_category_check": {
          "name": "accounting_submissions_category_check",
          "value": "char_length(\"accounting_submissions\".\"category\") between 1 and 128 AND \"accounting_submissions\".\"category\" ~ '[^[:space:]]'"
        },
        "accounting_submissions_description_check": {
          "name": "accounting_submissions_description_check",
          "value": "\"accounting_submissions\".\"description\" IS NULL OR (char_length(\"accounting_submissions\".\"description\") between 1 and 1024 AND \"accounting_submissions\".\"description\" ~ '[^[:space:]]')"
        },
        "accounting_submissions_amount_minor_check": {
          "name": "accounting_submissions_amount_minor_check",
          "value": "\"accounting_submissions\".\"amount_minor\" ~ '^[0-9]+$'"
        },
        "accounting_submissions_currency_check": {
          "name": "accounting_submissions_currency_check",
          "value": "\"accounting_submissions\".\"currency\" ~ '^[A-Z]{3}$'"
        },
        "accounting_submissions_settled_thb_amount_minor_check": {
          "name": "accounting_submissions_settled_thb_amount_minor_check",
          "value": "\"accounting_submissions\".\"settled_thb_amount_minor\" IS NULL OR \"accounting_submissions\".\"settled_thb_amount_minor\" ~ '^[1-9][0-9]*$'"
        },
        "accounting_submissions_settled_thb_currency_check": {
          "name": "accounting_submissions_settled_thb_currency_check",
          "value": "(\"accounting_submissions\".\"currency\" = 'THB' AND \"accounting_submissions\".\"settled_thb_amount_minor\" IS NULL) OR (\"accounting_submissions\".\"currency\" <> 'THB' AND \"accounting_submissions\".\"settled_thb_amount_minor\" IS NOT NULL)"
        },
        "accounting_submissions_evidence_reference_check": {
          "name": "accounting_submissions_evidence_reference_check",
          "value": "\"accounting_submissions\".\"evidence_reference\" ~ '^private-evidence://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(/[A-Za-z0-9._~-]+)+$' AND \"accounting_submissions\".\"evidence_reference\" NOT LIKE '%/../%' AND \"accounting_submissions\".\"evidence_reference\" NOT LIKE '%/./%' AND \"accounting_submissions\".\"evidence_reference\" NOT LIKE '%/..' AND \"accounting_submissions\".\"evidence_reference\" NOT LIKE '%/.'"
        },
        "accounting_submissions_status_check": {
          "name": "accounting_submissions_status_check",
          "value": "\"accounting_submissions\".\"status\" = 'pending'"
        }
      },
