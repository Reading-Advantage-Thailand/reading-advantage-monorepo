{
  "name": "@reading-advantage/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./company-identity": {
      "types": "./dist/company-identity/index.d.ts",
      "import": "./dist/company-identity/index.js"
    },
    "./company-identity/runtime": {
      "types": "./dist/company-identity/runtime.d.ts",
      "import": "./dist/company-identity/runtime.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed:codecamp": "tsx src/seed/codecamp-seed.ts",
    "doctor": "tsx scripts/migration-ledger-doctor.ts",
    "company-identity:generate": "drizzle-kit generate --config company-identity/drizzle.config.ts",
    "company-identity:migrate": "tsx src/company-identity/commands/migrate.ts",
    "company-identity:doctor": "tsx src/company-identity/commands/doctor.ts",
    "company-identity:bootstrap": "tsx src/company-identity/commands/bootstrap.ts",
    "company-identity:local-bootstrap": "tsx src/company-identity/commands/local-bootstrap.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.7.0",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.7",
    "tsx": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
