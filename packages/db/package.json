{
  "name": "@reading-advantage/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc --project tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed:codecamp": "tsx src/seed/codecamp-seed.ts",
    "doctor": "tsx scripts/migration-ledger-doctor.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "check-types:compat": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "check-types:rollback": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.7.0",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.7",
    "tsx": "catalog:",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
