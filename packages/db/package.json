{
  "name": "@reading-advantage/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed:codecamp": "tsx src/seed/codecamp-seed.ts",
    "doctor": "tsx scripts/migration-ledger-doctor.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.7.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@reading-advantage/config": "workspace:*",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.22.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
