# Accounting app — environment variables
#
# Copy this file to .env and fill in the values. In production these are
# provided via Cloud Run --set-secrets or --set-env-vars.

# ── Company auth (Accounts OIDC) ──────────────────────────────────────
COMPANY_AUTH_ISSUER_URL=https://accounts.reading-advantage.com
COMPANY_AUTH_OIDC_CLIENT_ID=accounting-web
COMPANY_AUTH_OIDC_CLIENT_SECRET=
COMPANY_AUTH_OIDC_REDIRECT_URI=http://localhost:3010/api/auth/callback
COMPANY_AUTH_EXPECTED_AUDIENCE=accounting
COMPANY_AUTH_CLOCK_SKEW_SECONDS=30
