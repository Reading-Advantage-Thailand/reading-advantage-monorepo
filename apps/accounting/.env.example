# Accounting app — environment variables
#
# Copy this file to .env and fill in the values. In production these are
# provided via Cloud Run --set-secrets or --set-env-vars.

# ── Company auth (Accounts OIDC) ──────────────────────────────────────
COMPANY_AUTH_ISSUER_URL=https://accounts.reading-advantage.com
COMPANY_AUTH_OIDC_CLIENT_ID=accounting-web
COMPANY_AUTH_OIDC_CLIENT_SECRET=
COMPANY_AUTH_OIDC_REDIRECT_URI=http://localhost:3010/api/auth/callback
COMPANY_AUTH_EXPECTED_AUDIENCE=accounting
COMPANY_AUTH_CLOCK_SKEW_SECONDS=30

# ── Accounting database ────────────────────────────────────────────────
# App requests use the least-privilege runtime role through PgBouncer 6432.
ACCOUNTING_DATABASE_URL=postgresql://accounting_runtime:accounting_runtime_local@localhost:6432/accounting
# Optional client-side pool bound. The default is 3; valid values are 1-20.
ACCOUNTING_DATABASE_POOL_MAX=3

# Migrations use the database owner through direct PostgreSQL 5432.
ACCOUNTING_DIRECT_DATABASE_URL=postgresql://accounting_migrator:accounting_migrator_local@localhost:5432/accounting

# ── Private evidence storage adapter ───────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=accounting
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
