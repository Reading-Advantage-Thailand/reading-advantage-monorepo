NODE_ENV=development
COMPANY_AUTH_DATABASE_URL=postgresql://company_identity_runtime:change-me@127.0.0.1:5432/company_identity
COMPANY_AUTH_DIRECT_DATABASE_URL=postgresql://company_identity_migration:change-me@127.0.0.1:5432/company_identity
COMPANY_AUTH_ISSUER_URL=http://localhost:3007
COMPANY_AUTH_OIDC_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
COMPANY_AUTH_OIDC_SIGNING_KEY_ID=accounts-local-1
COMPANY_AUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
COMPANY_AUTH_SSO_IDLE_TTL_SECONDS=28800
COMPANY_AUTH_SSO_ABSOLUTE_TTL_SECONDS=604800
COMPANY_AUTH_APP_SESSION_TTL_SECONDS=3600
COMPANY_AUTH_CLOCK_SKEW_SECONDS=30
COMPANY_AUTH_IDENTIFIER_HASH_KEY=replace-with-32-byte-base64url
COMPANY_AUTH_COOKIE_NAME=ra_company_sso
COMPANY_AUTH_COOKIE_SECURE=false
COMPANY_AUTH_COOKIE_SAME_SITE=lax
COMPANY_AUTH_COOKIE_PATH=/
