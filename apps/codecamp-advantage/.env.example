# Database
# - DATABASE_URL: pooled (transaction-mode PgBouncer). App queries use this.
#   postgres-js is configured with prepare:false + small per-process pool;
#   see packages/db/src/connection-options.ts.
# - DIRECT_DATABASE_URL: direct (session-mode) connection. Used by
#   drizzle-kit migrations, seeds, and any LISTEN/NOTIFY consumer.
#   Required because transaction-mode pooling breaks advisory locks,
#   multi-statement DDL, and session-scoped features.
DATABASE_URL="postgresql://postgres:postgres@localhost:6432/codecamp_advantage"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codecamp_advantage"

# Optional tuning for per-process pool size (default 3). Positive integer.
# DATABASE_POOL_MAX="3"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Auth
AUTH_SECRET=""

# Shared tutorial reporting and internal repository-capture worker.
# In a single Codecamp service, point the worker URL back to this app's internal route.
TUTORIAL_REPORT_SECRET=""
TUTORIAL_REPOSITORY_WORKER_URL="http://localhost:3000/api/internal/tutorial-repository-capture"
TUTORIAL_REPOSITORY_WORKER_TOKEN=""

# AI Providers
GOOGLE_AI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# GitHub App (for PR review webhooks)
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_INSTALLATION_ID=""

# Review Worker (Postgres-backed job queue for LLM review reliability)
# Track: webhook_review_reliability_20260605
# Set REVIEW_WORKER_ENABLED=1 to auto-start the worker on process boot.
# Without this, the worker only runs when createReviewWorker().start() is called.
# REVIEW_WORKER_ENABLED="1"

# How often the worker polls for due jobs (milliseconds). Default: 30000 (30s).
# REVIEW_WORKER_INTERVAL_MS="30000"

# Maximum retry attempts before a job moves to dead-letter (DLQ) state. Default: 5.
# REVIEW_WORKER_MAX_ATTEMPTS="5"

# Base delay for jittered exponential backoff (milliseconds). Default: 1000 (1s).
# Backoff formula: next_attempt_at = now + base * 2^attempts + random_jitter.
# REVIEW_WORKER_BACKOFF_BASE_MS="1000"

# Maximum jitter added to backoff delay (milliseconds). Default: 20% of BACKOFF_BASE_MS.
# REVIEW_WORKER_MAX_JITTER_MS="200"

# How long a claimed job may sit before it is considered abandoned and reclaimable.
# Should be longer than worst-case LLM review latency. Default: 900000 (15 minutes).
# REVIEW_WORKER_VISIBILITY_TIMEOUT_MS="900000"

# Number of jobs to claim per worker tick. Default: 5.
# REVIEW_WORKER_BATCH_SIZE="5"
