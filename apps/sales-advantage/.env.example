# Sales Advantage — Environment variables
# ========================================
# Copy this file to .env.local and fill in actual values.

# ── Database ────────────────────────────────────────────────
# Runtime database connection used by the app. For local development this can
# point directly at PostgreSQL. Cloud Run maps DATABASE_URL from one of two
# Secret Manager resources: SALES_DATABASE_URL in company mode, or
# SALES_LEGACY_DATABASE_URL for the no-traffic compatibility revision.
DATABASE_URL="postgresql://postgres:postgres@localhost:6432/reading_advantage"
# Local migration/seed connection. Cloud Run does not receive this variable.
# Cloud Build maps its deploy-only SALES_DIRECT_DATABASE_URL secret explicitly.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reading_advantage"

# ── Auth ────────────────────────────────────────────────────
# Select `company` for Accounts OIDC or `legacy-school` only for the bounded
# compatibility revision. Production traffic uses company mode.
SALES_AUTH_MODE=company
# Current company OIDC mode does not read AUTH_SECRET; its application session
# is an opaque Accounts-backed token. The legacy compatibility revision retains
# the SALES_AUTH_SECRET mapping while that bounded rollback surface exists.
AUTH_SECRET="please-change-in-production-at-least-32-chars-long"

# Accounts OIDC settings used only in company mode.
COMPANY_AUTH_ISSUER_URL="https://accounts.reading-advantage.com"
COMPANY_AUTH_OIDC_CLIENT_ID="sales-web"
# Cloud Run maps this runtime name from the
# SALES_COMPANY_AUTH_OIDC_CLIENT_SECRET Secret Manager resource.
COMPANY_AUTH_OIDC_CLIENT_SECRET="replace-with-local-development-client-secret"
COMPANY_AUTH_OIDC_REDIRECT_URI="http://localhost:3005/api/auth/callback"
COMPANY_AUTH_EXPECTED_AUDIENCE="sales"
COMPANY_AUTH_CLOCK_SKEW_SECONDS=30

# ── AI Provider ─────────────────────────────────────────────
# Selects the active AI adapter. Supported values:
#   "openrouter"  (primary for audio eval + chat)
#   "google"      (fallback)
#   "openai"      (text-only, no audio eval support)
#   "mock"        (dry runs / tests — returns canned responses)
AI_PROVIDER=openrouter

# ── OpenRouter (primary AI provider for audio eval + chat) ──
OPENROUTER_API_KEY="sk-or-v1-replace-me"

# ── Google AI (fallback audio eval provider) ─────────────────
GOOGLE_AI_API_KEY=""
# Alternate key names read by the Google provider adapter:
# GEMINI_API_KEY=""
# GOOGLE_API_KEY=""

# ── OpenAI (text-only fallback) ─────────────────────────────
OPENAI_API_KEY=""

# ── Sales Audio Eval — Model Overrides ──────────────────────
# Primary multimodal model for single-pass audio evaluation.
# Default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
SALES_AUDIO_EVAL_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
# Fallback STT model (text-only path, used when primary fails).
# Default: nvidia/parakeet-tdt-0.6b-v3
SALES_AUDIO_EVAL_FALLBACK_STT_MODEL="nvidia/parakeet-tdt-0.6b-v3"
# Fallback eval model (text-only, evaluates STT transcript).
# Default: nvidia/nemotron-3-nano-30b-a3b:free
SALES_AUDIO_EVAL_FALLBACK_EVAL_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"

# ── Sales Chat Tutor — Model Override ───────────────────────
# Model used for the text-only chat tutor (streamText).
# Default: nvidia/nemotron-3-nano-30b-a3b:free
SALES_CHAT_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"

# ── Storage (S3-compatible object storage) ──────────────────
# Endpoint URL. For local dev use MinIO (http://localhost:9000).
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
# Bucket name where audio recordings and other assets are stored.
STORAGE_BUCKET="sales-advantage"
# Note: The storage adapter reads STORAGE_ACCESS_KEY, not STORAGE_ACCESS_KEY_ID.
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
# Optional public base URL for generating signed/unsigned URLs.
STORAGE_PUBLIC_BASE_URL=""

# ── Next.js ─────────────────────────────────────────────────
# Public API URL — used by tRPC client during SSR.
NEXT_PUBLIC_API_URL="http://localhost:3005"
# Listen port (default 3005; Cloud Run uses PORT=8080 via Dockerfile).
PORT=3005

# ── Deployment-only Secret Manager resources ───────────────
# These names are consumed by cloudbuild.yaml. Do not add them to the Cloud Run
# runtime environment; Cloud Build maps only the required values to runtime
# names such as DATABASE_URL and COMPANY_AUTH_OIDC_CLIENT_SECRET.
# SALES_DIRECT_DATABASE_URL              migration, probes, seed, and repair
# SALES_DATABASE_URL                     company-mode Cloud Run DATABASE_URL
# SALES_LEGACY_DATABASE_URL              compatibility-revision DATABASE_URL
# SALES_AUTH_SECRET                       legacy compatibility mapping only
# SALES_CURRICULUM_APPROVAL_SHA256        approved curriculum release gate
# SALES_LEGACY_SOURCE_ROLE_REPAIR_MANIFEST bounded source-role repair manifest
#
# SALES_PRIVILEGED_ADMIN_DATABASE_URL is an operator-side provisioning input,
# documented in docs/deployment/sales-database-role-provisioning.md. It is not a
# Cloud Build or Cloud Run environment variable.
