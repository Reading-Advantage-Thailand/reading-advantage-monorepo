# Marketing Production Platform — required & optional environment variables
#
# Copy this file to .env and fill in the values. In production these are
# provided via Cloud Run --set-secrets or --set-env-vars.

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string for the marketing runtime DB.
# The marketing tables (campaigns, video_projects, etc.) are in migration
# 0021_sales_advantage and schema/marketing.ts.
DATABASE_URL=postgresql://user:password@host:5432/reading_advantage

# Direct (unpooled) connection for Drizzle migrations & doctor checks.
# Usually the same as DATABASE_URL but without PgBouncer/pooler.
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/reading_advantage

# ── Encryption ─────────────────────────────────────────────────────────
# 32-byte AES-256-GCM key as a 64-character hex string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used by lib/encryption.ts to encrypt LLM API keys stored in the settings table.
ENCRYPTION_KEY=

# ── Auth ───────────────────────────────────────────────────────────────
# Secret used by the auth package for session signing/verification.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── AI Provider (fallback) ────────────────────────────────────────────
# Default AI provider; the marketing app stores per-provider API keys in the
# settings table (encrypted with ENCRYPTION_KEY). These env vars are fallbacks
# used by @reading-advantage/ai when no DB-stored key exists.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=...

# ── Optional tweaks ───────────────────────────────────────────────────
# NODE_ENV is set by Cloud Run; you may override locally.
NODE_ENV=production

# Rate-limit bypass for local dev (auth package).
RATE_LIMIT_INMEMORY_FASTPATH=true
