# Marketing Production Platform — required & optional environment variables
#
# Copy this file to .env and fill in the values. In production these are
# provided via Cloud Run --set-secrets or --set-env-vars.

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string for the dedicated marketing database on the
# shared Cloud SQL instance. Cloud Run uses the Unix-socket URL shape below;
# replace the placeholder user and password through Secret Manager.
DATABASE_URL=postgresql://marketing_runtime:password@localhost/marketing?host=/cloudsql/reading-advantage:asia-southeast1:cloud-sql

# Direct migration-role connection to the same dedicated database. Cloud Build
# starts the Cloud SQL Auth Proxy at the declared Unix-socket path.
DIRECT_DATABASE_URL=postgresql://marketing_migration:password@localhost/marketing?host=/cloudsql/reading-advantage:asia-southeast1:cloud-sql

# ── Encryption ─────────────────────────────────────────────────────────
# 32-byte AES-256-GCM key as a 64-character hex string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used by lib/encryption.ts to encrypt LLM API keys stored in the settings table.
ENCRYPTION_KEY=

# ── Auth ───────────────────────────────────────────────────────────────
# Secret used by the auth package for session signing/verification.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── AI Provider (fallback) ────────────────────────────────────────────
# Default AI provider; the marketing app stores per-provider API keys in the
# settings table (encrypted with ENCRYPTION_KEY). These env vars are fallbacks
# used by @reading-advantage/ai when no DB-stored key exists.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=...

# ── Optional tweaks ───────────────────────────────────────────────────
# NODE_ENV is set by Cloud Run; you may override locally.
NODE_ENV=production

# Rate-limit bypass for local dev (auth package).
RATE_LIMIT_INMEMORY_FASTPATH=true
