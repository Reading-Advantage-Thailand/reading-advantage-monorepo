{
  "extends": "@reading-advantage/config/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "vinext" }],
    "paths": {
      "@/*": ["./app/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
