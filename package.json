{
  "name": "reading-advantage-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "architecture:inventory": "pnpm --filter @reading-advantage/architecture-enforcement exec tsx src/cli.ts",
    "build": "turbo run build",
    "dev": "docker compose up -d && turbo run dev",
    "lint": "turbo run lint",
    "test": "node node_modules/vitest/vitest.mjs run apps/codecamp-advantage/lib/__tests__/cold-start-optimization.test.ts apps/codecamp-advantage/lib/__tests__/_helpers/cloudbuild-parser.test.ts apps/codecamp-advantage/lib/__tests__/_helpers/cold-start-sampler.test.ts apps/codecamp-advantage/lib/__tests__/smoke-local-image-script.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "config-drift": "pnpm --filter @reading-advantage/config test",
    "prepare": "husky",
    "validate": "pnpm config-drift && turbo run lint test build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "drizzle-orm": "0.45.2",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
